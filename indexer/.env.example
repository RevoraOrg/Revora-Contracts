# Required. PostgreSQL connection string. The indexer refuses to start if unset or empty.
DATABASE_URL=postgres://username:password@localhost/revora_indexer

# Optional. Socket address the HTTP server binds to (default: 127.0.0.1:3000).
# Use 0.0.0.0:3000 only when intentionally exposing the indexer on all interfaces.
INDEXER_BIND_ADDR=127.0.0.1:3000

# Required. The indexer refuses to start if this is unset or empty.
# Generate with: openssl rand -hex 32
INDEXER_API_KEY=replace-with-a-strong-random-secret

# Optional. Comma-separated list of allowed CORS origins for all routes.
# If unset, any origin is allowed (fine for local dev, not for production).
# Example: INDEXER_CORS_ORIGINS=https://app.example.com,https://admin.example.com
INDEXER_CORS_ORIGINS=
